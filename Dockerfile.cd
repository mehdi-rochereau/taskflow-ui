# ============================================================
# CD Dockerfile — TaskFlow UI
#
# Runtime-only image — no Node.js, no npm, no compilation.
# The Angular production build is pre-compiled by the CI pipeline
# and passed as an artifact to the CD job, then copied here.
#
# Why a separate Dockerfile for CD?
#   The main Dockerfile compiles the Angular app with Node.js
#   during the Docker build. This is useful for local development
#   but wasteful in CI/CD — the build has already been compiled,
#   linted, and validated by the CI job.
#   This Dockerfile skips compilation entirely, reducing the
#   CD build time significantly.
#
# Base image: nginx:1.30-alpine
#   - Alpine 3.24 — minimal OS, smaller attack surface
#   - Nginx 1.30 stable branch — production-grade static file server
#   - No Node.js in the final image
#
#   Moved off nginx:1.26-alpine, whose Alpine 3.20 base reached end of life
#   on 2026-04-01. Trivy reported it on every run and warned that its
#   detection was becoming incomplete, which made the "no CRITICAL CVE"
#   verdict of the CD gate untrustworthy: the repository still served
#   packages but no longer received fixes for CVEs published after that date.
#
#   Stable and not mainline: mainline is on 1.31.x on the same Alpine base,
#   but this repository follows the stable branch, which only takes bug and
#   security fixes.
# ============================================================

FROM nginx:1.30-alpine

# Update Alpine packages to get the latest security patches.
# Kept after the base image bump for a different reason than before: it no
# longer works around an end-of-life base, it closes the gap between the date
# the base image was published and the date this image is built. A fix
# released in that window is picked up here rather than waiting for the next
# nginx image release.
RUN apk update && apk upgrade --no-cache

# Remove default Nginx configuration
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom Nginx configuration.
# nginx.conf handles Angular routing (fallback to index.html), cache policy
# and security headers. It does not proxy anything: the frontend calls
# api.taskflow.mehdi-rochereau.dev directly and CORS is handled by Spring.
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy Angular production build from CI artifact.
# In the CD pipeline, the build artifact is copied to browser-dist/
# at the repo root before the Docker build is invoked (see ci-cd.yml).
# This is necessary because Docker buildx sends the build context
# to an isolated builder daemon — nested paths like dist/taskflow-ui/browser/
# are not reliably accessible without placing the files at the root.
COPY browser-dist /usr/share/nginx/html

# Set correct ownership and permissions on static files.
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

# Document the application port.
# EXPOSE is metadata only — actual port mapping is in docker-compose.yml.
EXPOSE 80

# Start Nginx in foreground — required for Docker.
# PID 1 receives SIGTERM directly for graceful shutdown.
CMD ["nginx", "-g", "daemon off;"]
